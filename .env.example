# ===== AdsPower Local API =====
# AdsPower 本地 API 地址（客户端需处于开启状态）。默认端口 50325。
ADSPOWER_API_BASE=http://local.adspower.net:50325
# 若在 AdsPower 设置里开启了 API 鉴权，填写 API Key；否则留空。
ADSPOWER_API_KEY=
# 要接管的浏览器 profile 的 user_id（在 AdsPower 里每个环境的编号）。必填。
ADSPOWER_USER_ID=
# AdsPower 本地 API 单次请求超时（毫秒）。客户端未开启/挂起时避免永久阻塞。
ADSPOWER_API_TIMEOUT_MS=15000

# ===== 目标页面 =====
# App Store Connect 沙盒测试账号管理页。当前标签页已在该页时不会重复导航。
SANDBOX_URL=https://appstoreconnect.apple.com/access/users/sandbox

# ===== 账号数据来源（二选一，按优先级）=====
# 1)【明细表】逐个账号精确控制姓名/邮箱/国家。文件存在时优先使用。
#    表头支持 email / password / firstName / lastName / country（也认中文表头），只有 email 是必填列。
#    复制 data/accounts.example.csv 为 data/accounts.csv 后编辑即可。
ACCOUNTS_CSV=./data/accounts.csv
# 2)【按规则生成】明细表不存在时使用。邮箱模板必须含 {n}；{n:3} 表示补零到 3 位（001）。
GEN_EMAIL_PATTERN=
# 生成多少个账号。0 = 不生成（此时必须提供明细表）。也可用命令行 --count 覆盖。
GEN_COUNT=0
# 序号起始值，用于避开已创建过的编号。也可用命令行 --start 覆盖。
GEN_START_INDEX=1
# First / Last Name 模板，可含 {n}。列表页会显示成「<First> <Last>」。
GEN_FIRST_NAME_PATTERN=Sandbox
GEN_LAST_NAME_PATTERN={n}

# ===== 账号内容 =====
# 所有账号共用的密码。Apple 要求至少 8 位且含大写、小写、数字，启动时会校验。必填。
SANDBOX_PASSWORD=
# New Tester 弹窗里 Country or Region 的默认取值（需与页面选项文字完全一致）。
SANDBOX_COUNTRY=United States

# ===== 运行行为 =====
# 每步操作之间的放慢毫秒数（调试时调大更容易观察）。
SLOW_MO_MS=50
# 单步默认超时（毫秒）。
STEP_TIMEOUT_MS=30000
# 点击 Create 后等待服务端返回的时间（毫秒）。
POST_CREATE_WAIT_MS=2500
# 开始前先读一遍页面上已有账号邮箱，重复的直接跳过（幂等，可安全重跑）。true/false
SKIP_EXISTING=true
# 出错时截图保存目录。
SCREENSHOT_DIR=./screenshots
# 运行日志落盘目录（每次运行写 run-<时间戳>.log，出错截图用同一时间戳前缀便于对应）。
LOG_DIR=./logs
# 创建成功的账号追加落盘到这个 CSV，方便直接交给测试同学。留空则不落盘。
OUTPUT_CSV=./data/created-accounts.csv
# 运行结束后是否自动关闭 AdsPower 浏览器（true/false）。
CLOSE_BROWSER_ON_EXIT=false

# ===== 拟人化 / 防自动化检测 =====
# 拟人化总开关：随机停顿、鼠标移动、逐字符输入等，让节奏接近真人。true/false
HUMANIZE=true
# 步骤之间的随机「思考」停顿区间（毫秒）。
THINK_MIN_MS=600
THINK_MAX_MS=2200
# 逐字符键入时每个字符的随机间隔（毫秒）。
TYPE_MIN_MS=60
TYPE_MAX_MS=180
# 每个账号创建之间的随机停顿区间（毫秒）。
# 真人连建两个账号通常只停 1～3 秒等弹窗关掉再点「+」，不必拖到 10 秒。
BETWEEN_ACCOUNTS_MIN_MS=1500
BETWEEN_ACCOUNTS_MAX_MS=3500

# ===== 飞书（Lark）运行结果通知 =====
# 运行结束后把本次批量创建汇总（新建/跳过/失败、失败明细、日志路径）推送到飞书群。
# 在群里添加「自定义机器人」后复制其 Webhook 地址填到这里。留空则不发通知。
FEISHU_WEBHOOK_URL=
# 若机器人开启了「签名校验」，把签名密钥填这里；未开启则留空。
FEISHU_SIGN_SECRET=
# 发送飞书通知的请求超时（毫秒）。
FEISHU_TIMEOUT_MS=10000
