{
  // 编辑器与 npm run typecheck 用的配置：覆盖 src 与 test，避免测试文件落在项目之外
  // （那样编辑器会退回默认选项，连 node: 内置模块的类型都找不到）。
  // 仅构建用的 outDir / rootDir 见 tsconfig.build.json。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
