{
  "name": "sandbox-account-manager",
  "version": "1.0.0",
  "description": "Batch-create and batch-delete App Store Connect sandbox test accounts using Playwright + AdsPower.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "playwright",
    "adspower",
    "automation",
    "app-store-connect",
    "sandbox"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
